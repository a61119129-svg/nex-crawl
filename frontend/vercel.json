{
  "rewrites": [
    { "source": "/v1/:path*", "destination": "http://31.97.102.237/v1/:path*" },
    { "source": "/health", "destination": "http://31.97.102.237/health" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
